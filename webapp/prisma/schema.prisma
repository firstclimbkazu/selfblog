generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  articles  Article[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("categories")
}

model Tag {
  id          String       @id @default(uuid())
  name        String       @unique
  slug        String       @unique
  articleTags ArticleTag[]
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("tags")
}

model Article {
  id           String        @id @default(uuid())
  title        String
  slug         String        @unique
  body         String
  thumbnailUrl String?       @map("thumbnail_url")
  status       ArticleStatus @default(DRAFT)
  featuredOrder Int?         @unique @map("featured_order")
  publishedAt  DateTime?     @map("published_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  category     Category?     @relation(fields: [categoryId], references: [id])
  categoryId   String?       @map("category_id")
  articleTags  ArticleTag[]

  @@map("articles")
}

model ArticleTag {
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String  @map("article_id")
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String  @map("tag_id")

  @@id([articleId, tagId])
  @@map("article_tags")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model LandingPage {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  html            String
  css             String?
  js              String?
  headHtml        String?   @map("head_html")
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  metaOgImage     String?   @map("meta_og_image")
  status          LpStatus  @default(DRAFT)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  images          LpImage[]

  @@map("landing_pages")
}

model LpImage {
  id          String      @id @default(uuid())
  landingPage LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)
  lpId        String      @map("lp_id")
  publicUrl   String      @map("public_url")
  fileName    String      @map("file_name")
  fileSize    Int?        @map("file_size")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("lp_images")
}

enum LpStatus {
  DRAFT
  PUBLISHED
}
